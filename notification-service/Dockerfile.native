# syntax=docker/dockerfile:1.7
# Reversible Native Image pilot for notification-service.
# The JVM image remains notification-service/Dockerfile.
FROM ghcr.io/graalvm/native-image-community:24.0.2 AS builder
WORKDIR /workspace
RUN microdnf install -y findutils \
    && microdnf clean all
COPY . .
RUN --mount=type=cache,target=/root/.gradle \
    chmod +x ./gradlew \
    && sed -i 's#configserver:${CONFIG_SERVER_URL:#optional:configserver:${CONFIG_SERVER_URL:#' notification-service/src/main/resources/application.yml \
    && find . -name build.gradle.kts -exec sed -i 's/JavaLanguageVersion.of(21)/JavaLanguageVersion.of(24)/' {} + \
    && SPRING_PROFILES_ACTIVE=notification-service \
      SPRING_CONFIG_ADDITIONAL_LOCATION=file:/workspace/config-service/src/main/resources/config/notification-service.yml \
      CONFIG_SERVER_PASSWORD=build-only \
      INTERNAL_HMAC_SECRET=build-only \
      INTERNAL_REDIS_PASSWORD=build-only \
      SPRING_DATA_REDIS_PASSWORD=build-only \
      ./gradlew :notification-service:nativeCompile --no-daemon --stacktrace --max-workers=2

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system spring \
    && useradd --system --gid spring --no-create-home spring
USER spring:spring
WORKDIR /app
COPY --from=builder /workspace/notification-service/build/native/nativeCompile/notification-service app
EXPOSE 8088
ENTRYPOINT ["/app/app"]

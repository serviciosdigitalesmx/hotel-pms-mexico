# Copiar a .env (no se versiona) y completar. Los secretos se generan en el servidor (ver README.md).

# Dominio pÃºblico (el proxy del host lo publica con HTTPS hacia WEB_PORT).
DOMAIN=nuevo.techxto.ar
WEB_PORT=8086

# Secretos: generalos con openssl, no los inventes.
DB_PASSWORD=
JWT_KEY=
# Guardala tambiÃ©n en tu gestor de contraseÃ±as: sin ella, una copia de la base no puede descifrar los tokens
# de Mercado Pago ni los certificados ARCA.
MASTER_KEY=

# Email (opcional; sin esto los links de invitaciÃ³n y de contraseÃ±a se copian desde la app).
EMAIL_PROVIDER=None
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Fixi

# WhatsApp automÃ¡tico (opcional: None | Twilio | Meta). Sin esto, la app abre WhatsApp con el mensaje armado.
WHATSAPP_PROVIDER=None
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_TEMPLATE_NAME=

# Sugerencias de diagnÃ³stico con Claude (opcional: None | Anthropic).
AI_PROVIDER=None
ANTHROPIC_API_KEY=

# Suscripciones de los talleres (ver README â†’ Suscripciones).
# Dejalo en false hasta tener configurado al menos un medio de cobro.
SIGNUP_ENABLED=false
TRIAL_DAYS=14
# Precios mensuales: dÃ³lares (Paddle, fuera de Argentina) y pesos (Mercado Pago, Argentina).
PRICE_USD_BASIC=25
PRICE_USD_STANDARD=45
PRICE_USD_PRO=79
PRICE_ARS_BASIC=29900
PRICE_ARS_STANDARD=44900
PRICE_ARS_PRO=74900
# Mercado Pago de la plataforma (tu cuenta, no la de un taller).
MP_BILLING_ACCESS_TOKEN=
MP_BILLING_WEBHOOK_SECRET=
# Paddle Billing: sandbox para probar, production para cobrar.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_BASIC=
PADDLE_PRICE_STANDARD=
PADDLE_PRICE_PRO=

# Copias de seguridad.
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=6
RCLONE_REMOTE=

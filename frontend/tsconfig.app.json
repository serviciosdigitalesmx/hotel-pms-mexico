{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": ["src/App.tsx", "src/main.tsx", "src/fixi/**/*", "src/config/routes.tsx", "src/components/ui/**/*", "src/components/layouts/**/*", "src/components/app-sidebar.tsx", "src/components/nav-main.tsx", "src/components/nav-user.tsx", "src/components/theme-provider.tsx", "src/components/site-header.tsx", "src/components/site-footer.tsx", "src/components/command-search.tsx", "src/components/mode-toggle.tsx", "src/components/logo.tsx", "src/components/sidebar-notification.tsx", "src/hooks/**/*", "src/contexts/**/*", "src/lib/**/*"]
}

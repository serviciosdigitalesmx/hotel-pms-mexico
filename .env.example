# Copy to .env for local development. Keep real values only in a protected,
# untracked .env or secret files; never commit them.

# Required by the base/development Compose stack.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
CONFIG_SERVER_PASSWORD=
INTERNAL_HMAC_SECRET=
JWT_SECRET=

# Production pull-only Compose (docker-compose.yml + docker-compose.native.yml
# + docker-compose.prod.yml). FIXI_RELEASE_SHA must be the exact 40-char SHA
# whose ten application images were published and validated by GitHub Actions.
GHCR_OWNER=serviciosdigitalesmx
FIXI_RELEASE_SHA=
FIXI_PUBLIC_HOST=fixi.localhost
FIXI_PUBLIC_URL=
# Use https://fixi.localhost:8443 for the temporary loopback profile; later, use the approved HTTPS origin.
FIXI_HTTP_PORT=8080
FIXI_HTTPS_PORT=8443
FIXI_CONFIG_SERVER_DIGEST=
FIXI_API_GATEWAY_DIGEST=
FIXI_AUTH_SERVICE_DIGEST=
FIXI_GUEST_SERVICE_DIGEST=
FIXI_FRONTDESK_SERVICE_DIGEST=
FIXI_BILLING_SERVICE_DIGEST=
FIXI_FB_SERVICE_DIGEST=
FIXI_NOTIFICATION_SERVICE_DIGEST=
FIXI_FRONTEND_DIGEST=
FIXI_POSTGRES_DIGEST=
FIXI_REDIS_IMAGE=redis:8.8.1-alpine
FIXI_REDIS_DIGEST=
FIXI_CADDY_IMAGE=caddy:2.10.2-alpine
FIXI_CADDY_DIGEST=

# Required for encrypted production pgBackRest. Point to a protected local
# file containing the existing/approved passphrase; do not put its contents
# in this file. This workpack does not initialize B2 or repo2.
PGBACKREST_CIPHER_PASS_FILE=

# SMTP is optional for local runtime; configure only a synthetic/test relay
# until real email delivery is explicitly approved.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
NOTIFICATION_FROM_ADDRESS=
NOTIFICATION_FROM_NAME=

# Optional local observability. Required only when enabling its Compose profile.
GRAFANA_ADMIN_PASSWORD=

# Optional integrations and tuning.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
GW_CORS_ALLOWED_ORIGINS=http://localhost:5173
GW_DEFAULT_RATE_LIMIT_REPLENISH_RATE=10
GW_DEFAULT_RATE_LIMIT_BURST_CAPACITY=20
GW_AUTH_RATE_LIMIT_REPLENISH_RATE=5
GW_AUTH_RATE_LIMIT_BURST_CAPACITY=10
REDIS_APPENDONLY=no
REDIS_APPEND_FSYNC=everysec

# Optional off-site S3-compatible repo2. Leave unset until separately
# provisioned and approved; no B2 bucket or credentials are created here.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

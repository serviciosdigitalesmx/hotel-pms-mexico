# Native build context keeps source modules and the config-server JAR required
# by the build, while excluding generated output and unrelated product assets.
*/build/*
!config-service/build/libs/
!config-service/build/libs/*-SNAPSHOT.jar
.gradle/
.git/
.github/
.add/
.ralph-add/
scripts/ci/
frontend/
frontend/node_modules/
frontend/node_modules/**
frontend/**
**/build/
!config-service/build/
!config-service/build/libs/
!config-service/build/libs/*-SNAPSHOT.jar
docs/
backup/
argos
argos-local
.env
.env.*
**/.env
**/.env.*
*.backup-*
*.env.backup-*
**/node_modules/
frontend/

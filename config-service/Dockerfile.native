# syntax=docker/dockerfile:1.7
# Native Image variant for config-service. config-service/Dockerfile remains
# the supported JVM fallback and is not changed by this image.
FROM ghcr.io/graalvm/native-image-community:24.0.2 AS builder
ARG NATIVE_QUICK_BUILD=false
WORKDIR /workspace

# The native builder has no runtime secrets. This value is only used while
# Spring AOT evaluates application.yml and is never copied to the final stage.
RUN microdnf install -y findutils \
    && microdnf clean all
COPY . .

RUN --mount=type=cache,target=/root/.gradle \
    --mount=type=cache,target=/root/.m2 \
    chmod +x ./gradlew \
    && find . -name build.gradle.kts -exec sed -i 's/JavaLanguageVersion.of(21)/JavaLanguageVersion.of(24)/' {} + \
    && CONFIG_SERVER_PASSWORD=build-only-config-password \
       SPRING_PROFILES_ACTIVE=native \
       ./gradlew :config-service:nativeCompile \
         -PnativeQuickBuild="${NATIVE_QUICK_BUILD:-false}" \
         --no-daemon --stacktrace --max-workers=2

FROM debian:bookworm-slim
RUN groupadd --system spring \
    && useradd --system --gid spring --no-create-home spring
USER spring:spring
WORKDIR /app
COPY --from=builder /workspace/config-service/build/native/nativeCompile/config-service app
EXPOSE 8888 8090
ENTRYPOINT ["/app/app"]
